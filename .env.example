# Copy this file to .env and add your key. .env is git-ignored.

# OpenRouter key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Free models used when the key is set. Embedding models are tried in order (comma-separated).
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free,nvidia/nemotron-3.5-embed-8b:free,nvidia/nemotron-3.5-embed-1b:free
# Leave empty to skip reranking.
OPENROUTER_RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b:free
